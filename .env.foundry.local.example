# Copy this file to .env.foundry.local and fill in one download method.
# Keep .env.foundry.local uncommitted.

# Preferred for local agent testing: generate a Version 13 Node.js timed URL
# from https://foundryvtt.com/me/licenses and paste it here. Do not use the
# Linux, Windows, macOS, or latest v14 URL for this v13 system sandbox.
# FOUNDRY_RELEASE_URL=https://example.com/temporary-foundry-download-url

# Alternative: let the container download Foundry v13 using your account.
# FOUNDRY_USERNAME=you@example.com
# FOUNDRY_PASSWORD=your-foundry-password

# Optional when using a timed URL, useful for unattended activation tests.
# FOUNDRY_LICENSE_KEY=AAAA-BBBB-CCCC-DDDD-EEEE-FFFF

# Required for browser/admin testing. Use a local-only password.
FOUNDRY_ADMIN_KEY=change-me-local-only
