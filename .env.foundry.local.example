# Copy this file to .env.foundry.local and keep that copy uncommitted.
# Cursor Cloud Agents can also inject the same keys as Runtime Secrets.

# Required for browser/admin access. Use a local-only password.
FOUNDRY_ADMIN_KEY=change-me-local-only

# Required for unattended setup and E2E. First-run activation still talks to
# Foundry's license server. A timed URL does not activate the license.
# FOUNDRY_LICENSE_KEY=AAAA-BBBB-CCCC-DDDD-EEEE-FFFF

# Preferred durable install: place FoundryVTT-Node-14.368.zip in foundry-dist/
# as foundryvtt-14.368.zip, or point at a private copy you already downloaded.
# FOUNDRY_RELEASE_ARCHIVE=/absolute/path/to/FoundryVTT-Node-14.368.zip

# Optional private cache URL for CI/agents. This must not be a 5-minute Foundry
# timed URL. Pair it with the archive SHA-256.
# FOUNDRY_RELEASE_CACHE_URL=https://example.invalid/private/foundryvtt-14.368.zip
# FOUNDRY_RELEASE_SHA256=replace-with-the-sha256-of-foundryvtt-14.368.zip

# First-time local bootstrap only. Generate a Version 14 Node.js timed URL from
# https://foundryvtt.com/me/licenses. It expires in about five minutes. Later
# starts reuse foundry-dist/. Do not persist this on a Cloud environment.
# FOUNDRY_RELEASE_URL=https://example.com/temporary-foundry-download-url
