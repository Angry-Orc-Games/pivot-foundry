# Copy this file to .env.foundry.local and fill in one install method.
# Keep .env.foundry.local uncommitted.

# Preferred for a first install: generate a Version 14 Node.js timed URL
# from https://foundryvtt.com/me/licenses and paste it here. Do not use the
# Linux, Windows, macOS, or incompatible version URL. Timed URLs expire
# after about five minutes. Later starts reuse ignored foundry-app/.
# FOUNDRY_RELEASE_URL=https://example.com/temporary-foundry-download-url

# Alternative: path to a local Foundry v14 Node.js zip you already downloaded.
# Keep the official FoundryVTT-Node-14.* filename. Do not commit the zip.
# FOUNDRY_RELEASE_ARCHIVE=/absolute/path/to/FoundryVTT-Node-14.368.zip

# Optional: Node 24 binary used only to host Foundry. Repository npm scripts
# can stay on Node 20 or 22. If unset, the launcher uses Node 24 or nvm.
# FOUNDRY_NODE=/home/you/.nvm/versions/node/v24.0.0/bin/node

# Optional for first-run activation in the Foundry setup UI.
# A timed URL installs Foundry but does not activate the software license.
# FOUNDRY_LICENSE_KEY=AAAA-BBBB-CCCC-DDDD-EEEE-FFFF

# Required for browser/admin testing. Use a local-only password.
FOUNDRY_ADMIN_KEY=change-me-local-only
