<section class="pivot-npc-sheet" data-document-id="{{actor.id}}">
  <header class="pivot-sheet-header">
    <div class="pivot-title-block">
      <label for="{{rootId}}-name">{{localize "PIVOT.Fields.NPCName"}}</label>
      <input id="{{rootId}}-name" name="name" type="text" value="{{actor.name}}" {{disabledAttr}} />
    </div>
    <div class="pivot-header-stats">
      <label>
        <span>{{localize "PIVOT.Fields.CR"}}</span>
        <input name="system.cr" type="text" value="{{system.cr}}" {{disabledAttr}} />
      </label>
    </div>
  </header>

  <div class="pivot-sheet-body">
    <section class="pivot-classification">
      <h2>{{localize "PIVOT.Sections.Classification"}}</h2>

      <div class="pivot-attribute-row">
        <label>
          <span>{{localize "PIVOT.Fields.Tier"}}</span>
          <select name="system.tier" {{disabledAttr}}>
            <option value="gonk">{{localize "PIVOT.Tier.Gonk"}}</option>
            <option value="alphaGonk">{{localize "PIVOT.Tier.AlphaGonk"}}</option>
            <option value="boss">{{localize "PIVOT.Tier.Boss"}}</option>
            <option value="bbeg">{{localize "PIVOT.Tier.BBEG"}}</option>
          </select>
        </label>

        <label>
          <span>{{localize "PIVOT.Fields.CreatureType"}}</span>
          <select name="system.creatureType" {{disabledAttr}}>
            <option value="beast">{{localize "PIVOT.CreatureType.Beast"}}</option>
            <option value="humanoid">{{localize "PIVOT.CreatureType.Humanoid"}}</option>
            <option value="monster">{{localize "PIVOT.CreatureType.Monster"}}</option>
            <option value="undead">{{localize "PIVOT.CreatureType.Undead"}}</option>
          </select>
        </label>
      </div>

      <div class="pivot-attribute-row">
        <label>
          <span>{{localize "PIVOT.Fields.Overlay"}}</span>
          <select name="system.overlay" {{disabledAttr}}>
            <option value="none">{{localize "PIVOT.Overlay.None"}}</option>
            <option value="alpha">{{localize "PIVOT.Overlay.Alpha"}}</option>
            <option value="giant">{{localize "PIVOT.Overlay.Giant"}}</option>
            <option value="dire">{{localize "PIVOT.Overlay.Dire"}}</option>
            <option value="undead">{{localize "PIVOT.Overlay.Undead"}}</option>
          </select>
        </label>
      </div>
    </section>

    <section class="pivot-attributes">
      <h2>{{localize "PIVOT.Sections.Attributes"}}</h2>

      <div class="pivot-attribute-row">
        <label>
          <span>{{localize "PIVOT.Fields.HPCurrent"}}</span>
          <input
            name="system.attributes.hp.value"
            type="number"
            min="0"
            step="1"
            value="{{system.attributes.hp.value}}"
            {{disabledAttr}}
          />
        </label>

        <label>
          <span>{{localize "PIVOT.Fields.HPMax"}}</span>
          <input
            name="system.attributes.hp.max"
            type="number"
            min="0"
            step="1"
            value="{{system.attributes.hp.max}}"
            {{disabledAttr}}
          />
        </label>
      </div>

      <div class="pivot-attribute-row">
        <label>
          <span>{{localize "PIVOT.Fields.ArmourClass"}}</span>
          <input
            name="system.attributes.ac"
            type="number"
            min="0"
            step="1"
            value="{{system.attributes.ac}}"
            {{disabledAttr}}
          />
        </label>

        <label>
          <span>{{localize "PIVOT.Fields.Speed"}}</span>
          <input
            name="system.attributes.speed"
            type="number"
            min="0"
            step="1"
            value="{{system.attributes.speed}}"
            {{disabledAttr}}
          />
        </label>
      </div>
    </section>

    <section class="pivot-combat-bonuses">
      <h2>{{localize "PIVOT.Sections.CombatBonuses"}}</h2>

      <div class="pivot-attribute-row">
        <label>
          <span>{{localize "PIVOT.Fields.PhysicalBonus"}}</span>
          <input
            name="system.combatBonuses.physical"
            type="number"
            step="1"
            value="{{system.combatBonuses.physical}}"
            {{disabledAttr}}
          />
        </label>

        <label>
          <span>{{localize "PIVOT.Fields.IntellectualBonus"}}</span>
          <input
            name="system.combatBonuses.intellectual"
            type="number"
            step="1"
            value="{{system.combatBonuses.intellectual}}"
            {{disabledAttr}}
          />
        </label>
      </div>
    </section>

    <section class="pivot-biography">
      <h2>{{localize "PIVOT.Fields.Biography"}}</h2>
      <textarea name="system.biography" rows="8" {{disabledAttr}}>{{system.biography}}</textarea>
    </section>

    <section class="pivot-items">
      <h2>{{localize "PIVOT.Sections.Items"}}</h2>

      {{#if items}}
        <ul class="pivot-item-list">
          {{#each items}}
            <li class="pivot-item" data-item-id="{{this.id}}">
              <span class="pivot-item-name">{{this.name}}</span>
              <span class="pivot-item-type">{{this.type}}</span>
              <div class="pivot-item-controls">
                <button
                  type="button"
                  data-action="editItem"
                  data-item-id="{{this.id}}"
                  title="{{localize 'PIVOT.Actions.EditItem'}}"
                >
                  <i class="fas fa-edit"></i>
                </button>
                <button
                  type="button"
                  data-action="deleteItem"
                  data-item-id="{{this.id}}"
                  title="{{localize 'PIVOT.Actions.DeleteItem'}}"
                >
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="pivot-empty-message">{{localize "PIVOT.Messages.NoItems"}}</p>
      {{/if}}
    </section>
  </div>
</section>