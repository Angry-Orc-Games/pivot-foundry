{{! Tab navigation: Sheet | Survival | Inventory | Magic | Notes }}
<nav
  class="tabs pf-tabs"
  data-group="primary"
  aria-label="{{localize 'PIVOT.Sheets.Character.Navigation'}}"
>
  <a
    class="{{tabs.sheet.cssClass}}"
    data-action="tab"
    data-group="primary"
    data-tab="sheet"
  >{{localize "PIVOT.Tabs.Sheet"}}</a>
  <a
    class="{{tabs.survival.cssClass}}"
    data-action="tab"
    data-group="primary"
    data-tab="survival"
  >{{localize "PIVOT.Tabs.Survival"}}</a>
  <a
    class="{{tabs.inventory.cssClass}}"
    data-action="tab"
    data-group="primary"
    data-tab="inventory"
  >{{localize "PIVOT.Tabs.Inventory"}}</a>
  <a
    class="{{tabs.magic.cssClass}}"
    data-action="tab"
    data-group="primary"
    data-tab="magic"
  >{{localize "PIVOT.Tabs.Magic"}}</a>
  <a
    class="{{tabs.notes.cssClass}}"
    data-action="tab"
    data-group="primary"
    data-tab="notes"
  >{{localize "PIVOT.Tabs.Notes"}}</a>
</nav>