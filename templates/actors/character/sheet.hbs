{{! One-page print sheet. Survival, inventory, magic, and notes sit on this page. }}
<article class="pf-sheet-content pf-print pf-print-wrap pf-print-bottom">
  <div class="pf-cols">
    <div>
      <h3>Skills</h3>
      <table class="pf-table pf-skills">
        {{#each skillRows}}
          <tr>
            <td>
              <label class="pf-check"><input
                  class="pf-sr"
                  type="checkbox"
                  name="{{proficientPath}}"
                  {{checked proficient}}
                  {{disabledAttr}}
                  role="checkbox"
                  aria-label="Proficient in {{label}}"
                /><span class="pf-prof-mark" aria-hidden="true">{{#if
                    proficient
                  }}●{{else}}○{{/if}}</span><span>{{label}}{{#if expertise}}
                    (Expertise){{/if}}</span></label>
            </td>
            <td class="pf-small">{{ability}}</td>
            <td class="pf-r"><button
                type="button"
                class="pf-roll"
                data-action="roll"
                data-roll-kind="skill"
                data-key="{{id}}"
                data-label="{{label}}"
              >{{total}}</button></td>
          </tr>
        {{/each}}
      </table>
      <div class="pf-small">Languages: {{form.languagesText}}</div>

      <h3>Proficiencies</h3>
      <div class="pf-small">
        <div><b>Weapons:</b> {{proficiencyText.weapons}}</div>
        <div><b>Armour:</b> {{proficiencyText.armour}}</div>
        <div><b>Shields:</b> {{proficiencyText.shields}}</div>
      </div>
    </div>

    <div>
      <h3>Attacks</h3>
      <table class="pf-table pf-attacks">
        <thead>
          <tr>
            <th>Weapon</th>
            <th>Die</th>
            <th>Attack</th>
          </tr>
        </thead>
        <tbody>
          {{#each items.weapons}}
            <tr>
              <td><button
                  type="button"
                  class="pf-link"
                  data-action="openItem"
                  data-item-id="{{id}}"
                >{{name}}</button></td>
              <td><button
                  type="button"
                  class="pf-roll"
                  data-action="roll"
                  data-roll-kind="weaponDamage"
                  data-key="{{id}}"
                  data-label="{{name}} damage"
                >{{summary.damageFormula}}</button></td>
              <td class="pf-r"><button
                  type="button"
                  class="pf-roll"
                  data-action="roll"
                  data-roll-kind="weaponAttack"
                  data-key="{{id}}"
                  data-label="{{name}} attack"
                >{{summary.bth}}</button></td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      <div class="pf-small">Proficiency bonus is added when proficient. Exploding dice: natural max
        re-rolls once.</div>

      <h3>Feats</h3>
      <ul class="pf-list">
        {{#each items.feats}}
          <li><button
              type="button"
              class="pf-link"
              data-action="openItem"
              data-item-id="{{id}}"
            >{{name}}</button></li>
        {{/each}}
      </ul>

      {{#if items.bodyModifications}}
        <h3>Body modifications</h3>
        <ul class="pf-list">
          {{#each items.bodyModifications}}
            <li><button
                type="button"
                class="pf-link"
                data-action="openItem"
                data-item-id="{{id}}"
              >{{name}}</button></li>
          {{/each}}
        </ul>
      {{/if}}

      <section class="pf-magic">
        <h3>Magic</h3>
        <label class="pf-check"><input
            name="system.magic.awakened"
            type="checkbox"
            {{checked system.magic.awakened}}
            {{disabledAttr}}
          />
          <span>{{localize "PIVOT.Fields.Awakened"}}</span></label>
        <label><span>{{localize "PIVOT.Fields.MagicAbility"}}</span><select
            name="system.magic.ability"
            {{disabledAttr}}
          >{{selectOptions
              config.magicAbilities
              selected=system.magic.ability
              blank=""
              valueAttr="key"
              labelAttr="label"
            }}</select></label>
        <div class="pf-small">MP
          <input
            class="pf-inline pf-num"
            name="system.magic.mp.value"
            type="number"
            min="0"
            step="1"
            value="{{system.magic.mp.value}}"
            {{disabledAttr}}
          />
          /
          {{derived.magic.mp.max}}{{#if system.magic.ability}}, ability
            {{system.magic.ability}}{{/if}}</div>
        <div class="pf-resource-actions">
          <button
            type="button"
            data-action="adjustResource"
            data-path="magic.mp.value"
            data-delta="-1"
            aria-label="{{localize 'PIVOT.Actions.DecreaseMP'}}"
            title="{{localize 'PIVOT.Actions.DecreaseMP'}}"
            {{disabledAttr}}
          >-</button>
          <span>{{system.magic.mp.value}} / {{derived.magic.mp.max}}</span>
          <button
            type="button"
            data-action="adjustResource"
            data-path="magic.mp.value"
            data-delta="1"
            aria-label="{{localize 'PIVOT.Actions.IncreaseMP'}}"
            title="{{localize 'PIVOT.Actions.IncreaseMP'}}"
            {{disabledAttr}}
          >+</button>
        </div>
        <div class="pf-section-header"><h3>{{localize "PIVOT.Sections.MagicStreams"}}</h3><button
            type="button"
            data-action="createItem"
            data-type="magicStream"
            aria-label="{{localize 'PIVOT.Actions.CreateMagicStream'}}"
            title="{{localize 'PIVOT.Actions.CreateMagicStream'}}"
            {{disabledAttr}}
          >+</button></div>
        <ul class="pf-list">
          {{#each items.magicStreams}}
            <li><button
                type="button"
                class="pf-link"
                data-action="openItem"
                data-item-id="{{id}}"
              >{{name}}</button>
              <span class="pf-small">{{localize "PIVOT.Fields.Echelon"}} {{system.echelon}}</span>
              <button
                type="button"
                data-action="deleteItem"
                data-item-id="{{id}}"
                aria-label="{{localize 'PIVOT.Actions.DeleteItem'}}"
                title="{{localize 'PIVOT.Actions.DeleteItem'}}"
                {{disabledAttr}}
              >x</button></li>
          {{/each}}
        </ul>
        <div class="pf-section-header"><h3>{{localize "PIVOT.Sections.MagicAbilities"}}</h3><button
            type="button"
            data-action="createItem"
            data-type="magicAbility"
            aria-label="{{localize 'PIVOT.Actions.CreateMagicAbility'}}"
            title="{{localize 'PIVOT.Actions.CreateMagicAbility'}}"
            {{disabledAttr}}
          >+</button></div>
        <ul class="pf-list">
          {{#each items.magicAbilities}}
            <li><button
                type="button"
                class="pf-roll"
                data-action="roll"
                data-roll-kind="magicAbility"
                data-key="{{id}}"
                data-label="{{name}}"
              >{{name}}</button>
              <span class="pf-small">{{system.mpCost}} MP</span>
              <button
                type="button"
                data-action="openItem"
                data-item-id="{{id}}"
                aria-label="{{localize 'PIVOT.Actions.EditItem'}}"
                title="{{localize 'PIVOT.Actions.EditItem'}}"
                {{disabledAttr}}
              >...</button>
              <button
                type="button"
                data-action="deleteItem"
                data-item-id="{{id}}"
                aria-label="{{localize 'PIVOT.Actions.DeleteItem'}}"
                title="{{localize 'PIVOT.Actions.DeleteItem'}}"
                {{disabledAttr}}
              >x</button></li>
          {{/each}}
        </ul>
        <div class="pf-small">{{#if magicStreamsText}}Core streams:
            {{magicStreamsText}}{{/if}}</div>
        <label class="pf-wide-field"><span>{{localize "PIVOT.Sections.Runes"}}</span><textarea
            name="system.notes.runesThaumaturgy"
            rows="3"
            {{disabledAttr}}
          >{{system.notes.runesThaumaturgy}}</textarea></label>
      </section>

      {{#if items.flaws}}
        <h3>Flaws</h3>
        <ul class="pf-list">
          {{#each items.flaws}}
            <li><button
                type="button"
                class="pf-link"
                data-action="openItem"
                data-item-id="{{id}}"
              >{{name}}</button>{{#if system.cost.bp}}
                <span class="pf-bp-cost">(+{{system.cost.bp}} BP)</span>{{/if}}</li>
          {{/each}}
        </ul>
      {{/if}}

      <h3>Traits</h3>
      <ul class="pf-list">
        {{#each items.traits}}
          <li><button
              type="button"
              class="pf-link"
              data-action="openItem"
              data-item-id="{{id}}"
            >{{name}}</button></li>
        {{/each}}
      </ul>
    </div>
  </div>

  <h3>Gear and funds</h3>
  <div class="pf-cols">
    <ul class="pf-list">
      {{#each items.equipment}}
        <li>{{name}}{{#if system.quantity}} ({{system.quantity}}){{/if}}</li>
      {{/each}}
      {{#if derived.armourClass.armourWorn}}
        <li><i>Wearing: {{derived.armourClass.armourWorn}}</i></li>
      {{/if}}
    </ul>
    <div>
      <div class="pf-funds">
        <label>GP
          <input
            class="pf-inline pf-num"
            name="system.currency.gp"
            type="number"
            min="0"
            step="1"
            value="{{system.currency.gp}}"
            {{disabledAttr}}
          /></label>
        <label>SP
          <input
            class="pf-inline pf-num"
            name="system.currency.sp"
            type="number"
            min="0"
            step="1"
            value="{{system.currency.sp}}"
            {{disabledAttr}}
          /></label>
        <label>CP
          <input
            class="pf-inline pf-num"
            name="system.currency.cp"
            type="number"
            min="0"
            step="1"
            value="{{system.currency.cp}}"
            {{disabledAttr}}
          /></label>
        <label>Other
          <input
            class="pf-inline"
            name="system.currency.other"
            type="text"
            value="{{system.currency.other}}"
            {{disabledAttr}}
          /></label>
      </div>
      <div class="pf-small">Weight carried: {{derived.totalWeight}}</div>
    </div>
  </div>

  <section class="pf-inventory">
    <div class="pf-section-header">
      <h3>Weapons</h3>
      <button
        type="button"
        data-action="createItem"
        data-type="weapon"
        aria-label="{{localize 'PIVOT.Actions.CreateWeapon'}}"
        title="{{localize 'PIVOT.Actions.CreateWeapon'}}"
        {{disabledAttr}}
      >+</button>
    </div>
    <div class="pf-table pf-weapon-table">
      <div class="pf-table-head"><span>{{localize "PIVOT.Fields.Weapon"}}</span><span
        >BTH</span><span>BTD</span><span>{{localize "PIVOT.Fields.Damage"}}</span><span>{{localize
            "PIVOT.Fields.Range"
          }}</span><span></span></div>
      {{#each items.weapons}}
        <div class="pf-table-row" data-item-id="{{id}}">
          <button
            type="button"
            class="pf-item-name"
            data-action="openItem"
            data-item-id="{{id}}"
          >{{name}}</button>
          <button
            type="button"
            data-action="roll"
            data-roll-kind="weaponAttack"
            data-key="{{id}}"
            data-label="{{name}} attack"
          >{{summary.bth}}</button>
          <span>{{summary.btd}}</span>
          <button
            type="button"
            data-action="roll"
            data-roll-kind="weaponDamage"
            data-key="{{id}}"
            data-label="{{name}} damage"
          >{{summary.damageFormula}}</button>
          <span>{{summary.range.normal}} / {{summary.range.long}}</span>
          <button
            type="button"
            data-action="deleteItem"
            data-item-id="{{id}}"
            aria-label="{{localize 'PIVOT.Actions.DeleteItem'}}"
            title="{{localize 'PIVOT.Actions.DeleteItem'}}"
            {{disabledAttr}}
          >x</button>
        </div>
      {{/each}}
    </div>

    <div class="pf-section-header">
      <h3>Armour</h3>
      <button
        type="button"
        data-action="createItem"
        data-type="armour"
        aria-label="{{localize 'PIVOT.Actions.CreateArmour'}}"
        title="{{localize 'PIVOT.Actions.CreateArmour'}}"
        {{disabledAttr}}
      >+</button>
    </div>
    <p class="pf-breakdown pf-small">{{derived.armourClass.armourWorn}}
      |
      {{derived.armourClass.breakdown}}</p>
    <div class="pf-table pf-armour-table">
      <div class="pf-table-head"><span>{{localize "PIVOT.Fields.Item"}}</span><span>{{localize
            "PIVOT.Fields.Category"
          }}</span><span>{{localize "PIVOT.Fields.Bonus"}}</span><span>{{localize
            "PIVOT.Fields.Equipped"
          }}</span><span></span></div>
      {{#each items.armour}}
        <div class="pf-table-row" data-item-id="{{id}}">
          <button
            type="button"
            class="pf-item-name"
            data-action="openItem"
            data-item-id="{{id}}"
          >{{name}}</button><span>{{system.category}}</span><span>{{system.acBonus}}</span><span
          >{{#if system.equipped}}{{localize "PIVOT.Common.Yes"}}{{else}}{{localize
                "PIVOT.Common.No"
              }}{{/if}}</span>
          <button
            type="button"
            data-action="deleteItem"
            data-item-id="{{id}}"
            aria-label="{{localize 'PIVOT.Actions.DeleteItem'}}"
            title="{{localize 'PIVOT.Actions.DeleteItem'}}"
            {{disabledAttr}}
          >x</button>
        </div>
      {{/each}}
    </div>

    <div class="pf-section-header">
      <h3>Equipment</h3>
      <strong class="pf-small">{{localize "PIVOT.Fields.WeightTotal"}}:
        {{derived.totalWeight}}</strong>
      <button
        type="button"
        data-action="createItem"
        data-type="equipment"
        aria-label="{{localize 'PIVOT.Actions.CreateEquipment'}}"
        title="{{localize 'PIVOT.Actions.CreateEquipment'}}"
        {{disabledAttr}}
      >+</button>
    </div>
    <div class="pf-table pf-equipment-table">
      <div class="pf-table-head"><span>{{localize "PIVOT.Fields.Item"}}</span><span>{{localize
            "PIVOT.Fields.Quantity"
          }}</span><span>{{localize "PIVOT.Fields.Weight"}}</span><span>{{localize
            "PIVOT.Fields.Carried"
          }}</span><span></span></div>
      {{#each items.equipment}}
        <div class="pf-table-row" data-item-id="{{id}}">
          <button
            type="button"
            class="pf-item-name"
            data-action="openItem"
            data-item-id="{{id}}"
          >{{name}}</button><span>{{system.quantity}}</span><span>{{system.weight}}</span><span
          >{{#if system.carried}}{{localize "PIVOT.Common.Yes"}}{{else}}{{localize
                "PIVOT.Common.No"
              }}{{/if}}</span>
          <button
            type="button"
            data-action="deleteItem"
            data-item-id="{{id}}"
            aria-label="{{localize 'PIVOT.Actions.DeleteItem'}}"
            title="{{localize 'PIVOT.Actions.DeleteItem'}}"
            {{disabledAttr}}
          >x</button>
        </div>
      {{/each}}
    </div>
  </section>

  <section class="pf-survival">
    <h3>{{localize "PIVOT.Sections.Survival"}}</h3>
    <div class="pf-vitality-grid">
      <div class="pf-meter-block">
        <div class="pf-meter-heading">
          <span>{{localize "PIVOT.Fields.HPMax"}}</span>
          <strong>{{system.attributes.hp.value}} / {{system.attributes.hp.max}}</strong>
        </div>
        <div class="pf-meter" aria-hidden="true">
          <div class="pf-meter-fill hp" style="width: {{hpPercent}}%;"></div>
        </div>
        <div class="pf-meter-fields">
          <label><span>{{localize "PIVOT.Fields.HPCurrent"}}</span><input
              class="pf-inline pf-num"
              name="system.attributes.hp.value"
              aria-label="Current HP"
              type="number"
              min="0"
              step="1"
              value="{{system.attributes.hp.value}}"
              {{disabledAttr}}
            /></label>
          <label><span>{{localize "PIVOT.Fields.HPMax"}}</span><input
              name="system.attributes.hp.max"
              type="number"
              min="0"
              step="1"
              value="{{system.attributes.hp.max}}"
              {{disabledAttr}}
            /></label>
        </div>
      </div>
      <div class="pf-meter-block">
        <div class="pf-meter-heading">
          <span>{{localize "PIVOT.Fields.Pool"}}</span>
          <strong>{{system.resources.pool.value}} / {{derived.pool.max}}</strong>
        </div>
        <div class="pf-meter" aria-hidden="true">
          <div class="pf-meter-fill pool" style="width: {{poolPercent}}%;"></div>
        </div>
        <div class="pf-resource-actions">
          <button
            type="button"
            data-action="adjustResource"
            data-path="resources.pool.value"
            data-delta="-1"
            aria-label="{{localize 'PIVOT.Actions.DecreasePool'}}"
            title="{{localize 'PIVOT.Actions.DecreasePool'}}"
            {{disabledAttr}}
          >-</button>
          <input
            class="pf-pool-value"
            name="system.resources.pool.value"
            type="number"
            min="0"
            step="1"
            value="{{system.resources.pool.value}}"
            aria-label="{{localize 'PIVOT.Fields.Pool'}}"
            {{disabledAttr}}
          />
          <button
            type="button"
            data-action="adjustResource"
            data-path="resources.pool.value"
            data-delta="1"
            aria-label="{{localize 'PIVOT.Actions.IncreasePool'}}"
            title="{{localize 'PIVOT.Actions.IncreasePool'}}"
            {{disabledAttr}}
          >+</button>
        </div>
        <button
          type="button"
          class="pf-sheet-button"
          data-action="recoverPoolLongRest"
          aria-label="{{localize 'PIVOT.Actions.RecoverPoolLongRest'}}"
          title="{{localize 'PIVOT.Actions.RecoverPoolLongRest'}}"
          {{disabledAttr}}
        >{{localize "PIVOT.Actions.RecoverPoolLongRest"}}</button>
      </div>
      <label class="pf-hit-die"><span>{{localize "PIVOT.Fields.HitDie"}}</span><select
          name="system.attributes.hitDie"
          {{disabledAttr}}
        >{{selectOptions config.hitDiceChoices selected=system.attributes.hitDie}}</select></label>
    </div>
    <div class="pf-rest-actions">
      <button
        type="button"
        class="pf-sheet-button"
        data-action="shortRest"
        {{disabledAttr}}
      >{{localize "PIVOT.Actions.ShortRest"}}</button>
      <button
        type="button"
        class="pf-sheet-button"
        data-action="longRest"
        {{disabledAttr}}
      >{{localize "PIVOT.Actions.LongRest"}}</button>
    </div>
    <div class="pf-survival-header">
      <span class="pf-status {{survivalStatus}}">{{localize survivalLabel}}</span>
    </div>
    <div class="pf-temp-hp">
      <span>{{localize "PIVOT.Survival.Temp"}}</span>
      <strong>{{system.attributes.hp.temp}}</strong>
    </div>
    <div class="pf-survival-actions">
      <button
        type="button"
        class="pf-sheet-button primary"
        data-action="survivalRoll"
        {{disabledAttr}}
      >{{localize "PIVOT.Survival.RollTitle"}}</button>
      <button type="button" class="pf-sheet-button" data-action="tempHp" {{disabledAttr}}>{{localize
          "PIVOT.Survival.Temp"
        }}</button>
      <button
        type="button"
        class="pf-sheet-button"
        data-action="deathSave"
        {{disabledAttr}}
      >{{localize "PIVOT.Survival.DeathSave"}}</button>
      <button
        type="button"
        class="pf-sheet-button"
        data-action="clearTempHp"
        {{disabledAttr}}
      >{{localize "PIVOT.Survival.ClearTemp"}}</button>
      {{#if isGM}}<button
          type="button"
          class="pf-sheet-button"
          data-action="correctSurvival"
        >{{localize "PIVOT.Survival.Correction"}}</button>{{/if}}
    </div>
    <div class="pf-death-saves">
      <div class="pf-death-track">
        <span>{{localize "PIVOT.Fields.Successes"}}</span>
        <div
          class="pf-pips"
          role="img"
          aria-label="{{localize
            'PIVOT.Fields.Successes'
          }}: {{system.attributes.deathSaves.successes}}"
        >
          {{#each deathSaveSuccessPips}}
            {{#if this}}
              <span class="pf-pip success filled"></span>
            {{else}}
              <span class="pf-pip success"></span>
            {{/if}}
          {{/each}}
        </div>
      </div>
      <div class="pf-death-track">
        <span>{{localize "PIVOT.Fields.Failures"}}</span>
        <div
          class="pf-pips"
          role="img"
          aria-label="{{localize
            'PIVOT.Fields.Failures'
          }}: {{system.attributes.deathSaves.failures}}"
        >
          {{#each deathSaveFailurePips}}
            {{#if this}}
              <span class="pf-pip failure filled"></span>
            {{else}}
              <span class="pf-pip failure"></span>
            {{/if}}
          {{/each}}
        </div>
      </div>
    </div>
    <p class="pf-survival-note pf-small">{{localize "PIVOT.Survival.ManualConsequences"}}</p>
  </section>

  <section class="pf-loyalty">
    <h3>Loyalty and details</h3>
    <div><b>Loyalty:</b>
      <input
        class="pf-inline"
        name="system.identity.loyalty"
        type="text"
        value="{{system.identity.loyalty}}"
        {{disabledAttr}}
      /></div>
    {{#if system.identity.backgroundText}}<div><b>From:</b>
        {{system.identity.backgroundText}}</div>{{/if}}
    {{#if system.identity.speciesText}}<div><b>Looks:</b>
        {{system.identity.speciesText}}</div>{{/if}}
    <label class="pf-wide-field"><span>Notes</span><textarea
        name="system.notes.special"
        rows="4"
        {{disabledAttr}}
      >{{system.notes.special}}</textarea></label>
    <div class="pf-field-grid">
      <label><span>{{localize "PIVOT.Fields.Player"}}</span><input
          name="system.identity.player"
          type="text"
          value="{{system.identity.player}}"
          {{disabledAttr}}
        /></label>
      <label><span>{{localize "PIVOT.Fields.Background"}}</span><input
          name="system.identity.backgroundText"
          type="text"
          value="{{system.identity.backgroundText}}"
          {{disabledAttr}}
        /></label>
      <label><span>{{localize "PIVOT.Fields.Species"}}</span><input
          name="system.identity.speciesText"
          type="text"
          value="{{system.identity.speciesText}}"
          {{disabledAttr}}
        /></label>
      <label><span>{{localize "PIVOT.Fields.Languages"}}</span><input
          name="system.identity.languagesText"
          type="text"
          value="{{form.languagesText}}"
          {{disabledAttr}}
        /></label>
      <label><span>{{localize "PIVOT.Fields.Weight"}}</span><input
          name="system.identity.weight.value"
          type="number"
          min="0"
          step="0.1"
          value="{{system.identity.weight.value}}"
          {{disabledAttr}}
        /></label>
      <label><span>{{localize "PIVOT.Fields.Height"}}</span><input
          name="system.identity.height"
          type="text"
          value="{{system.identity.height}}"
          {{disabledAttr}}
        /></label>
      <label><span>{{localize "PIVOT.Fields.Age"}}</span><input
          name="system.identity.age"
          type="text"
          value="{{system.identity.age}}"
          {{disabledAttr}}
        /></label>
      <label><span>{{localize "PIVOT.Fields.Eyes"}}</span><input
          name="system.identity.eyes"
          type="text"
          value="{{system.identity.eyes}}"
          {{disabledAttr}}
        /></label>
      <label><span>{{localize "PIVOT.Fields.Hair"}}</span><input
          name="system.identity.hair"
          type="text"
          value="{{system.identity.hair}}"
          {{disabledAttr}}
        /></label>
    </div>
    <div class="pf-specializations">
      <label class="pf-wide-field"><span>{{localize
            "PIVOT.Fields.AcademiaSpecializations"
          }}</span><input
          name="system.skillSpecializations.academiaText"
          type="text"
          value="{{form.academiaText}}"
          {{disabledAttr}}
        /></label>
      <label class="pf-wide-field"><span>{{localize
            "PIVOT.Fields.CraftingSpecializations"
          }}</span><input
          name="system.skillSpecializations.craftingText"
          type="text"
          value="{{form.craftingText}}"
          {{disabledAttr}}
        /></label>
    </div>
    <div class="pf-section-header"><h3>{{localize "PIVOT.Sections.Features"}}</h3><button
        type="button"
        data-action="createItem"
        data-type="feature"
        aria-label="{{localize 'PIVOT.Actions.CreateFeature'}}"
        title="{{localize 'PIVOT.Actions.CreateFeature'}}"
        {{disabledAttr}}
      >+</button></div>
    <ul class="pf-list">
      {{#each items.features}}
        <li><button
            type="button"
            class="pf-link"
            data-action="openItem"
            data-item-id="{{id}}"
          >{{name}}</button>
          <span class="pf-small">{{system.category}}</span>
          <button
            type="button"
            data-action="deleteItem"
            data-item-id="{{id}}"
            aria-label="{{localize 'PIVOT.Actions.DeleteItem'}}"
            title="{{localize 'PIVOT.Actions.DeleteItem'}}"
            {{disabledAttr}}
          >x</button></li>
      {{/each}}
    </ul>
  </section>

  <div class="pf-small pf-footer">Build Points:
    {{system.progression.buildPoints}}
    · Progression Points:
    {{system.progression.progressionPoints}}
    · Rules: the book wins if this sheet disagrees.</div>
</article>