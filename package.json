{
  "name": "pivot-foundry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "vite build && npm run build:content",
    "build:content": "node scripts/build-content-packs.mjs",
    "dev": "vite build --watch",
    "foundry": "node scripts/foundry-cli.mjs",
    "foundry:check-env": "node scripts/foundry-cli.mjs check-env",
    "foundry:doctor": "node scripts/foundry-cli.mjs doctor",
    "foundry:provision": "node scripts/foundry-cli.mjs provision",
    "foundry:up": "node scripts/foundry-cli.mjs up",
    "foundry:status": "node scripts/foundry-cli.mjs status",
    "foundry:logs": "node scripts/foundry-cli.mjs logs",
    "foundry:down": "node scripts/foundry-cli.mjs down",
    "foundry:reset": "node scripts/foundry-cli.mjs reset",
    "foundry:e2e": "node scripts/foundry-cli.mjs e2e",
    "test:e2e": "node scripts/foundry-cli.mjs e2e",
    "test:e2e:staging": "node scripts/run-external-e2e.mjs staging",
    "test:e2e:production": "node scripts/run-external-e2e.mjs production",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=moderate",
    "prepare:release": "node scripts/prepare-release-manifest.mjs",
    "package:system": "node scripts/build-system-package.mjs",
    "artifact:identity": "node scripts/artifact-identity.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run audit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
