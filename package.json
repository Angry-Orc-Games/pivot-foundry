{
  "name": "pivot-foundry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "vite build && npm run build:content",
    "build:content": "node scripts/build-content-packs.mjs",
    "dev": "vite build --watch",
    "foundry:check-env": "node scripts/check-foundry-env.mjs",
    "foundry:down": "node scripts/foundry-host.mjs down",
    "foundry:logs": "node scripts/foundry-host.mjs logs",
    "foundry:up": "node scripts/foundry-host.mjs up",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=moderate",
    "prepare:release": "node scripts/prepare-release-manifest.mjs",
    "package:system": "node scripts/build-system-package.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run audit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
